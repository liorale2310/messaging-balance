{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/db/.*\\.db\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/db/global-setup.ts",
  "setupFilesAfterEnv": ["<rootDir>/test/db/harness.ts"],
  "testTimeout": 30000
}
